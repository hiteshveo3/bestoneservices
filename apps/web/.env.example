# Use Application Default Credentials in Firebase App Hosting / Google Cloud.
FIREBASE_PROJECT_ID=

# For a non-Google server, provide all three values securely in the host.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Local alternative: path to an uncommitted service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=
