rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
    function isStaff() { return signedIn() && request.auth.token.role == 'staff'; }
    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerUid == request.auth.uid)
        || (isStaff() && resource.data.assignedStaffUid == request.auth.uid);
      allow write: if false;
    }
    match /customers/{customerId} { allow read: if isAdmin() || (signedIn() && request.auth.uid == customerId); allow write: if false; }
    match /users/{userId} { allow read: if isAdmin() || (signedIn() && request.auth.uid == userId); allow write: if false; }
    match /bookingEvents/{eventId} { allow read: if isAdmin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
