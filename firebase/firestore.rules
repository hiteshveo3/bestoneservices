rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /bookings/{bookingId} { allow read: if request.auth != null && resource.data.customerUid == request.auth.uid; allow write: if false; }
    match /customers/{customerId} { allow read: if request.auth != null && request.auth.uid == customerId; allow write: if false; }
    match /bookingEvents/{eventId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
